{
  "name": "@namphuongtechnologi/acs-chat-react",
  "version": "1.2.1",
  "description": "React + TypeScript Azure Communication Services (ACS) Chat Library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/styles.css": "./dist/styles.css",
    "./dist/index.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/namphuongso/ACS-Chat-React.git"
  },
  "keywords": [
    "react",
    "chat",
    "chat-ui",
    "acs",
    "azure-communication-services",
    "react-hooks",
    "headless-chat",
    "ui-components",
    "typescript",
    "i18n"
  ],
  "author": "Nam Phuong Technology",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@azure/communication-chat": "^1.6.0",
    "@azure/communication-common": "^2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@namphuongtechnologi/azure-blob-transfer": "^1.2.1",
    "dompurify": "^3.0.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "react-i18next": "^17.0.11",
    "react-virtuoso": "^4.0.0",
    "uuid": "^9.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@azure/communication-chat": "^1.6.0",
    "@azure/communication-common": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@types/dompurify": "^3.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.102.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.3.0"
  }
}
